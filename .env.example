# Obtain a free-tier key from https://aistudio.google.com/apikey
# Keep this file local. Never add your real .env or API key to GitHub.
GEMINI_API_KEY=paste-your-api-key-here

# Optional: create one administrator at first server startup.
# Never commit a real admin password; set these only in your private .env.
# WASTELENS_ADMIN_EMAIL=you@example.com
# WASTELENS_ADMIN_PASSWORD=replace-with-12-plus-character-secret
# WASTELENS_DB=backend/data/wastelens.sqlite3
# WASTELENS_COOKIE_SECURE=1  # Enable when deploying behind HTTPS
